@model Vendra.Models.Product
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<h2>Yeni Marka Ekle</h2>

<form asp-action="AddProduct" method="post">
    <div class="form-group">
        <label>Ürün Adı</label>
        <input asp-for="Name" class="form-control" />
    </div>
    <div class="form-group">
        <label>Marka</label>
        <input asp-for="Brand" class="form-control" />
    </div>
    <div class="form-group">
        <label>Resim URL</label>
        <input asp-for="ImageUrl" class="form-control" placeholder="Örn: /images/urun1.jpg veya tam URL" />
    </div>
    <div class="form-group">
        <label>Fiyat</label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" />
    </div>
    <button type="submit" class="btn btn-success">Markayı Ekle</button>
</form>
