@page
@model IEnumerable<Vendra.Models.Product>
@{
    ViewData["Title"] = "Satıcı Paneli";
    Layout = "_Layout";
}

<h2>Satıcı Paneli</h2>

<a asp-controller="Product" asp-action="Create" class="btn btn-primary mb-3">Ürün Ekle</a>


@if (!Model.Any())
{
    <p>Henüz ürününüz yok. <a asp-controller="Product" asp-action="Create">İlk ürününüzü ekleyin.</a></p>
}
else
{
    <div class="row">
        @foreach (var p in Model)
        {
            <div class="col-md-4">
                <div class="card mb-3">
                    <img src="@p.ImageUrl" class="card-img-top" alt="@p.Name" />
                    <div class="card-body">
                        <h5 class="card-title">@p.Name</h5>
                        <p class="card-text">@p.Description</p>
                        <p class="card-text"><strong>@p.Price ₺</strong></p>
                    </div>
                </div>
            </div>
        }
    </div>
}
