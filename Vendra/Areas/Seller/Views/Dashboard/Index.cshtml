@model IEnumerable<Vendra.Models.Product>
@{
    ViewData["Title"] = "Satıcı Paneli";
}

<h2>Satıcı Paneli</h2>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card p-3 shadow">
            <h5>Toplam Ürün</h5>
            <p>@ViewBag.TotalProducts</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow">
            <h5>Toplam Stok</h5>
            <p>@ViewBag.TotalStock</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-3 shadow">
            <h5>Toplam Değer</h5>
            <p>@ViewBag.TotalValue ₺</p>
        </div>
    </div>
</div>

<a class="btn btn-primary mb-3" href="@Url.Action("Create", "Products", new { area = "Seller" })">+ Yeni Ürün Ekle</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Ürün Adı</th>
            <th>Fiyat</th>
            <th>Stok</th>
            <th>Kategori</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Price ₺</td>
                <td>@item.Stock</td>
                <td>@item.Category</td>
                <td>
                    <a href="@Url.Action("Delete", "Dashboard", new { area = "Seller", id = item.Id })"
                       class="btn btn-danger btn-sm">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
