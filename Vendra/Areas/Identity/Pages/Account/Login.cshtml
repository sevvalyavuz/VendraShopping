@page
@model Vendra.Areas.Identity.Pages.Account.LoginModel
@{
	ViewData["Title"] = "Login";
}
<h3 class="RegisterText">Giriş yap</h3>

<div class="Login">
    <form method="post">
        <div class="form-group">
            <label>Email</label>
            <input asp-for="Input.Email" class="form-control" />
        </div>
        <div class="form-group">
            <label>Şifre</label>
            <input asp-for="Input.Password" type="password" class="form-control" />
        </div>
        <div class="form-group form-check">
            <input asp-for="Input.RememberMe" type="checkbox" class="form-check-input" />
            <label asp-for="Input.RememberMe" class="form-check-label">Beni hatırla</label>
        </div>
        <button type="submit" class="btn btn-primary m-4">Giriş yap</button>
    
    </form>
</div>

