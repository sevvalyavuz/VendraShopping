@page
@model Vendra.Areas.Identity.Pages.Account.RegisterModel
@{
	ViewData["Title"] = "Register";
}

<h2 class="RegisterText">Üye ol</h2>

<div class="login">
    <form method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label>Email</label>
            <input asp-for="Input.Email" class="form-control" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Şifre</label>
            <input asp-for="Input.Password" type="password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Şifreyi Tekrarla</label>
            <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label>Kullanıcı Tipi</label>
            <select asp-for="Input.Type" class="form-control">
                <option value="Customer">Müşteri</option>
                <option value="Seller">Satıcı</option>
                <option value="Admin">Admin</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Üye ol</button>
    </form>

</div>
